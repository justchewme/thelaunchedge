{
  "version": 2,
  "public": true,
  "redirects": [
    { "source": "/Home.html", "destination": "/", "permanent": true },
    { "source": "/Home.html:anchor", "destination": "/:anchor", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/sitemap.xml", "destination": "/public/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/public/robots.txt" },
    { "source": "/article.css", "destination": "/public/article.css" },
    { "source": "/uploads/(.*)", "destination": "/public/uploads/$1" },
    { "source": "/essays", "destination": "/public/essays/index.html" },
    { "source": "/essays/", "destination": "/public/essays/index.html" },
    { "source": "/essays/:cluster", "destination": "/public/essays/:cluster/index.html" },
    { "source": "/essays/:cluster/", "destination": "/public/essays/:cluster/index.html" },
    { "source": "/essays/:cluster/:slug", "destination": "/public/essays/:cluster/:slug.html" },
    { "source": "/((?!api/)(?!essays/).*)\\.html", "destination": "/public/$1.html" }
  ]
}
